---
// Looping animation of global AR masks detected from IVT (always shown, black) and,
// optionally, IVTE (blue) and IKEV (red), drawn as outlines. Data: public/data/<case>/,
// written by analysis/scripts/07_export_masks.py.
//   <MaskAnimation size={0.9}>Caption…</MaskAnimation>
// `size` scales the figure's full width (1 = 62rem); it never exceeds the screen.
import { asset } from '../lib/asset';

interface Props {
  /** Folder under public/data/ written by analysis/scripts/07_export_masks.py */
  case?: string;
  /** Width relative to the default wide-figure width (62rem). */
  size?: number;
}
const { case: caseName = 'ar-masks-2010-01', size = 1 } = Astro.props;
const base = asset(`data/${caseName}/`);
// Optional outlines and whether each starts on. IVT is always drawn.
const extra = [
  ['IVTE', true],
  ['IKEV', false],
] as const;
---

<figure class="figure wide armasks" style={`--fig-scale: ${size}`}>
  <ar-masks data-base={base} tabindex="0" role="group" aria-label="Animated maps of atmospheric rivers detected from IVT, IVTE and IKEV, January 2010">
    <header class="am-head">
      <h3>Detected ARs, January 2010</h3>
      <div class="am-metrics" role="group" aria-label="Also outline ARs detected from">
        {extra.map(([k, on]) => (
          <button type="button" class={`m-${k.toLowerCase()}`} data-metric={k} aria-pressed={String(on)}>{k}</button>
        ))}
      </div>
    </header>
    <div class="am-map">
      <svg aria-hidden="true"></svg>
      <ul class="am-key">
        <li><span class="am-swatch m-ivt"></span>IVT</li>
        {extra.map(([k, on]) => (
          <li data-key={k} hidden={!on}><span class={`am-swatch m-${k.toLowerCase()}`}></span>{k}</li>
        ))}
      </ul>
    </div>
    <div class="am-controls">
      <button type="button" class="am-play" aria-label="Play">▶</button>
      <input class="am-slider" type="range" min="0" max="0" value="0" step="1" aria-label="Time" />
      <span class="am-time" aria-live="off">—</span>
    </div>
    <p class="am-status" role="status">Loading data…</p>
  </ar-masks>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  .armasks { margin-block: 4rem; } /* same room as the frequency figure above it */
  ar-masks { display: block; font-family: var(--sans); }
  ar-masks:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 6px; }
  /* Outline colors: IVT black, IVTE blue, IKEV red. */
  ar-masks { --m-ivt: #111827; --m-ivte: #1f6fb2; --m-ikev: #c0392b; }
  .m-ivt { --c: var(--m-ivt); }
  .m-ivte { --c: var(--m-ivte); }
  .m-ikev { --c: var(--m-ikev); }
  .am-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 0.75rem; margin-bottom: 0.5rem; }
  .am-head h3 { margin: 0; font-size: 1.05rem; line-height: 1.25; }
  /* Checklist: each button toggles its outline on or off, in its own color. */
  .am-metrics { display: inline-flex; gap: 0.35rem; flex: none; }
  .am-metrics button {
    font: inherit; font-size: 0.8rem; border: 1px solid var(--c); border-radius: 999px; cursor: pointer;
    background: var(--bg); color: var(--c); padding: 0.15rem 0.7rem;
  }
  .am-metrics button[aria-pressed='true'] { background: var(--c); color: #fff; }
  .am-map { position: relative; width: 100%; border: 1px solid var(--border); border-radius: 4px; overflow: hidden; background: #fff; }
  .am-map svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .am-map :global(.grat) { stroke: #9ca3af; stroke-width: 0.5; stroke-dasharray: 2 3; fill: none; }
  .am-map :global(.coast) { stroke: #6b7280; stroke-width: 0.6; fill: none; }
  .am-map :global(.tick) { font-size: 10px; fill: #4b5563; paint-order: stroke; stroke: rgba(255, 255, 255, 0.85); stroke-width: 3px; }
  /* AR outlines, drawn in grid units and scaled, so the stroke width is set in pixels. */
  .am-map :global(.ar) { fill: none; stroke: var(--c); stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  /* the outlines are created by the script, so their colors need :global() too */
  .am-map :global(.ar.m-ivt) { --c: var(--m-ivt); stroke-width: 1.2; }
  .am-map :global(.ar.m-ivte) { --c: var(--m-ivte); }
  .am-map :global(.ar.m-ikev) { --c: var(--m-ikev); }
  .am-map :global(.ar.m-ivte), .am-map :global(.ar.m-ikev) { stroke-width: 2.6; stroke-opacity: 0.85; }
  .am-key {
    position: absolute; top: 0.45rem; left: 0.45rem; margin: 0; padding: 0.2rem 0.55rem; list-style: none;
    display: flex; gap: 0.75rem; background: rgba(255, 255, 255, 0.88); border-radius: 4px; pointer-events: none;
    font-size: 0.85rem; font-weight: 600;
  }
  .am-key li[hidden] { display: none; }
  .am-swatch { display: inline-block; width: 1.2rem; margin-right: 0.35rem; vertical-align: middle; border-top: 2.5px solid var(--c); }
  .am-swatch.m-ivt { border-top-width: 1.5px; }
  .am-controls { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.9rem; font-size: 0.9rem; }
  .am-play {
    width: 2.25rem; height: 2.25rem; flex: none; border: 1px solid var(--border); border-radius: 999px;
    background: var(--bg); color: var(--text); cursor: pointer;
  }
  .am-slider { flex: 1; min-width: 4rem; accent-color: var(--accent); }
  .am-time { min-width: 8.5rem; text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); }
  .am-status { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--muted); }
  .am-status:empty { display: none; }
</style>

<script>
  import { contours } from 'd3-contour';
  import { fetchBin } from '../lib/fetch-bin';
  import { aspectRatio, overlay, type Grid, type Lines } from '../lib/global-map';

  type Manifest = {
    grid: Grid;
    times: string[];
    fps: number;
    file: string;
    encoding: string;
    bits: Record<string, number>;
  };

  // Drawn bottom to top, so the thin IVT outline stays visible on top of the others.
  const ORDER = ['IKEV', 'IVTE', 'IVT'];
  const CACHE_MAX = 240; // outline paths kept (each ~40 kB); recomputing one takes a few ms

  class MaskAnimation extends HTMLElement {
    private m!: Manifest;
    private lines!: Lines;
    private masks!: Uint8Array; // bitfield, frame after frame
    private paths = new Map<string, string>(); // `${metric}:${frame}` → outline path in grid units, newest last
    private shown = new Set(['IVT']);
    private t = 0;
    private timer: number | undefined;
    private userPaused = false;
    private slider!: HTMLInputElement;
    private playBtn!: HTMLButtonElement;
    private mapEl!: HTMLElement;

    async connectedCallback() {
      const base = this.dataset.base!;
      this.slider = this.querySelector('.am-slider')!;
      this.playBtn = this.querySelector('.am-play')!;
      this.mapEl = this.querySelector('.am-map')!;
      const status = this.querySelector('.am-status')!;
      this.querySelectorAll<HTMLButtonElement>('[data-metric]').forEach((b) => {
        if (b.getAttribute('aria-pressed') === 'true') this.shown.add(b.dataset.metric!);
      });
      try {
        const [m, lines] = await Promise.all([
          fetch(base + 'manifest.json').then((r) => r.json()),
          fetch(base + 'lines.json').then((r) => r.json()),
        ]);
        this.m = m;
        this.lines = lines;
        this.mapEl.style.aspectRatio = String(aspectRatio(m.grid));
        // The masks (about 1 MB) load only once the figure is near the screen.
        await new Promise<void>((resolve) => {
          const io = new IntersectionObserver((entries) => {
            if (entries.some((en) => en.isIntersecting)) { io.disconnect(); resolve(); }
          }, { rootMargin: '800px 0px' });
          io.observe(this);
        });
        this.masks = new Uint8Array(await fetchBin(base + m.file));
        this.slider.max = String(m.times.length - 1);
        status.textContent = '';
        this.bind();
        this.render();
        this.observe();
      } catch (e) {
        status.textContent = 'Could not load the figure data.';
        console.error(e);
      }
    }

    disconnectedCallback() { this.pause(false); }

    /**
     * Outline of one metric's mask at frame t, in grid units (cell i spans x = i..i+1).
     * The grid is padded with one wrapped column on each side, so an AR crossing the map's
     * left/right edge is not closed off with a line along the edge.
     */
    private outline(metric: string, t: number) {
      const key = `${metric}:${t}`;
      if (!this.paths.has(key)) {
        const { nx, ny } = this.m.grid;
        const bit = 1 << this.m.bits[metric], off = t * nx * ny, w = nx + 2;
        const v = new Uint8Array(w * ny);
        for (let j = 0; j < ny; j++) {
          const row = off + j * nx;
          for (let i = -1; i <= nx; i++) v[j * w + i + 1] = this.masks[row + ((i + nx) % nx)] & bit ? 1 : 0;
        }
        const [c] = contours().size([w, ny]).thresholds([0.5])(v as unknown as number[]);
        const d = c.coordinates.map((poly) => poly.map((ring) =>
          'M' + ring.map(([x, y]) => `${(x - 1).toFixed(1)},${y.toFixed(1)}`).join('L') + 'Z').join('')).join('');
        this.paths.set(key, d);
        // Keep the most recent outlines only: a month of them would hold tens of MB of paths.
        if (this.paths.size > CACHE_MAX) this.paths.delete(this.paths.keys().next().value!);
      }
      return this.paths.get(key)!;
    }

    // ---------- interaction ----------
    private bind() {
      this.playBtn.addEventListener('click', () => (this.playing ? this.pause() : this.play()));
      this.slider.addEventListener('input', () => { this.pause(); this.t = Number(this.slider.value); this.render(); });
      this.querySelectorAll<HTMLButtonElement>('[data-metric]').forEach((b) =>
        b.addEventListener('click', () => {
          const k = b.dataset.metric!, on = !this.shown.has(k);
          if (on) this.shown.add(k); else this.shown.delete(k);
          b.setAttribute('aria-pressed', String(on));
          this.querySelector<HTMLElement>(`[data-key="${k}"]`)!.hidden = !on;
          this.render();
        }));
      this.addEventListener('keydown', (e) => {
        if (e.target !== this) return;
        if (e.key === ' ') { e.preventDefault(); this.playing ? this.pause() : this.play(); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); this.step(1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); this.step(-1); }
      });
      let resizeTimer: number | undefined;
      new ResizeObserver(() => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(() => this.render(), 50); }).observe(this);
    }

    /** Play while on screen, unless the reader paused it or prefers reduced motion. */
    private observe() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      new IntersectionObserver((entries) => {
        const vis = entries.some((en) => en.isIntersecting);
        if (vis && !this.userPaused) this.play();
        else if (!vis) this.pause(false);
      }, { threshold: 0.3 }).observe(this);
    }

    get playing() { return this.timer !== undefined; }

    play() {
      clearInterval(this.timer);
      this.userPaused = false;
      this.timer = window.setInterval(() => this.step(1, false), 1000 / this.m.fps);
      this.playBtn.textContent = '⏸';
      this.playBtn.setAttribute('aria-label', 'Pause');
    }

    pause(byUser = true) {
      clearInterval(this.timer);
      this.timer = undefined;
      if (byUser) this.userPaused = true;
      this.playBtn.textContent = '▶';
      this.playBtn.setAttribute('aria-label', 'Play');
    }

    /** Move d frames, wrapping around (the animation loops). */
    step(d: number, byUser = true) {
      if (byUser) this.pause();
      const n = this.m.times.length;
      this.t = (this.t + d + n) % n;
      this.render();
    }

    // ---------- drawing ----------
    private base = ''; // graticule and coastlines for the current size
    private baseSize = '';

    private render() {
      const W = this.mapEl.clientWidth, H = this.mapEl.clientHeight;
      if (!W || !H) return;
      const svg = this.mapEl.querySelector('svg')!;
      if (this.baseSize !== `${W}x${H}`) {
        const key = this.querySelector<HTMLElement>('.am-key')!;
        this.base = overlay(this.m.grid, this.lines, W, H, key.offsetTop + key.offsetHeight + 4);
        this.baseSize = `${W}x${H}`;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      }
      const { nx, ny } = this.m.grid;
      const ars = ORDER.filter((k) => this.shown.has(k))
        .map((k) => `<path class="ar m-${k.toLowerCase()}" d="${this.outline(k, this.t)}"/>`).join('');
      svg.innerHTML = `${this.base}<g transform="scale(${W / nx},${H / ny})">${ars}</g>`;
      this.slider.value = String(this.t);
      this.querySelector('.am-time')!.textContent = this.m.times[this.t].replace('T', ' ').replace(/Z$/, ' UTC');
    }
  }

  customElements.define('ar-masks', MaskAnimation);
</script>
